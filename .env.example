# Environment for the Vercel + Neon deployment. Copy to .env for local dev
# (gitignored). In production these are set in the Vercel dashboard, NOT here.

# Neon POOLED connection string. Must use the -pooler host and ?sslmode=require
# ONLY — do NOT include channel_binding=require (PgBouncer transaction mode
# rejects it). Copy from the Neon console (Pooled connection) and strip
# channel_binding. Format (fill in your own values):
#   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secret for signing partner session cookies (any long random string).
SESSION_SECRET=change-me-to-a-long-random-string

# Secret for signing admin session cookies (different from SESSION_SECRET).
ADMIN_SESSION_SECRET=change-me-to-another-long-random-string

# Shared admin password (the /admin login gate).
ADMIN_PASSWORD=choose-a-strong-password

# Email recorded as posted_by on use cases created in the admin cockpit.
ADMIN_EMAIL=admin@example.com

# https in production => leave true. Set false ONLY for local http testing.
COOKIE_SECURE=true

# Clerk (partner auth) — publishable key is public; set in Vercel for the build.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxx

# Email notifications via Gmail SMTP (no sending domain required — Gmail delivers
# to any recipient). Use a dedicated Gmail account + a Google "App Password"
# (16 chars, requires 2-Step Verification on that account). NOT the normal
# account password. Create at: https://myaccount.google.com/apppasswords
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional friendly From display name (defaults to "lakeAlliance").
EMAIL_FROM_NAME=lakeAlliance
# Optional overrides (defaults are Gmail SSL): SMTP_HOST=smtp.gmail.com SMTP_PORT=465

# Optional: address(es) that also receive EOI notifications (comma-separated).
EOI_NOTIFY_EMAILS=
